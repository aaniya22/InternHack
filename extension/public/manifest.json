{
  "manifest_version": 3,
  "name": "InternHack Autofill",
  "description": "Autofill internship and job applications with your InternHack profile.",
  "version": "0.1.0",
  "icons": {
    "16": "logo.png",
    "32": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "action": {
    "default_title": "InternHack Autofill",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "logo.png",
      "32": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    }
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://api.internhack.xyz/*",
    "https://www.internhack.xyz/*",
    "https://internhack.xyz/*",
    "https://openrouter.ai/*",
    "https://*.linkedin.com/*",
    "https://*.workdayjobs.com/*",
    "https://*.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://*.ashbyhq.com/*",
    "https://*.indeed.com/*",
    "https://wellfound.com/*",
    "https://*.wellfound.com/*",
    "https://angel.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*",
        "https://*.workdayjobs.com/*",
        "https://*.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://*.ashbyhq.com/*",
        "https://*.indeed.com/*",
        "https://wellfound.com/*",
        "https://*.wellfound.com/*",
        "https://angel.co/*"
      ],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.internhack.xyz/*",
        "https://internhack.xyz/*",
        "http://localhost:5173/*"
      ],
      "js": ["assets/bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["logo.png"],
      "matches": [
        "https://*.linkedin.com/*",
        "https://*.workdayjobs.com/*",
        "https://*.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://*.ashbyhq.com/*",
        "https://*.indeed.com/*",
        "https://wellfound.com/*",
        "https://*.wellfound.com/*",
        "https://angel.co/*"
      ]
    }
  ]
}
